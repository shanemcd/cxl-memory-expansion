<domain type='kvm'>
  <name>forensic-libvirt-locked</name>
  <memory unit='MiB'>1024</memory>
  <currentMemory unit='MiB'>1024</currentMemory>
  <vcpu>1</vcpu>
  <memoryBacking><locked/></memoryBacking>
  <os><type arch='x86_64' machine='q35'>hvm</type><boot dev='hd'/></os>
  <cpu mode='host-passthrough'/>
  <features><acpi/><apic/></features>
  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/tmp/forensic-libvirt-overlay.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <interface type='ethernet'>
      <target dev='lvtap0' managed='yes'/>
      <model type='virtio'/><driver name='vhost'/>
    </interface>
    <serial type='file'><source path='/tmp/forensic-libvirt.serial.log'/><target port='0'/></serial>
    <memballoon model='none'/>
  </devices>
</domain>
